# 로컬: `npx supabase start` 후 `npx supabase status` 의 API_URL · ANON_KEY
# 배포(Vercel): Supabase 대시보드 Project Settings → API 의 URL · anon(publishable) 키
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# iOS 앱(Capacitor) 빌드에서만: 비밀번호 재설정 메일 링크가 돌아올 웹 주소 (예: https://도메인.com).
# 웹 배포에서는 비워 두면 현재 주소를 쓴다.
VITE_SITE_URL=
