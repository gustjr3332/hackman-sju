DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=webclaude
POSTGRES_USER=webclaude
POSTGRES_PASSWORD=webclaude
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# In production (Render/Railway/Supabase), set DATABASE_URL instead and the
# POSTGRES_* vars above are ignored.
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Supabase 를 쓸 때는 반드시 "풀러" 호스트를 써야 한다. 직접 연결
# (db.<project-ref>.supabase.co)은 무료 플랜에서 IPv6 전용이라 Render 의
# IPv4 아웃바운드에서 닿지 않고 연결 타임아웃만 난다. 유저명이 postgres 가
# 아니라 postgres.<project-ref> 인 것도 주의.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 심사 도구의 GitHub 열람용 읽기 전용 토큰. 없으면 서버 IP 하나로 시간당 60회를 모든
# 심사위원이 나눠 쓰게 되므로, 심사 도구를 실제로 쓸 대회라면 넣는 편이 좋다(시간당 5000회).
# 공개 저장소만 읽으므로 권한(scope)은 필요 없다.
# GITHUB_TOKEN=
# 스코어보드 집계 캐시 수명(초). 점수/팀/제출물이 바뀌면 즉시 무효화된다.
# SCOREBOARD_CACHE_SECONDS=3
# GitHub 응답 캐시 수명(초).
# GITHUB_CACHE_SECONDS=1800

# LLM 제공사 키 (팀빌딩 프로필 자동 정리 / 심사 보조). 모두 선택이고, 설정된 것만 화면의
# 모델 선택기에 뜬다. 하나도 없으면 LLM 기능만 꺼지고 나머지는 그대로 동작한다 —
# 팀빌딩 추천 순위는 규칙 기반이라 키 없이도 계산된다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
