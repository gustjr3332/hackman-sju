DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=webclaude
POSTGRES_USER=webclaude
POSTGRES_PASSWORD=webclaude
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# In production (Render/Railway), set DATABASE_URL instead and the
# POSTGRES_* vars above are ignored.
# DATABASE_URL=postgres://user:password@host:5432/dbname

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 심사 도구의 GitHub 열람용 읽기 전용 토큰. 없으면 서버 IP 하나로 시간당 60회를 모든
# 심사위원이 나눠 쓰게 되므로, 심사 도구를 실제로 쓸 대회라면 넣는 편이 좋다(시간당 5000회).
# 공개 저장소만 읽으므로 권한(scope)은 필요 없다.
# GITHUB_TOKEN=
# 스코어보드 집계 캐시 수명(초). 점수/팀/제출물이 바뀌면 즉시 무효화된다.
# SCOREBOARD_CACHE_SECONDS=3
# GitHub 응답 캐시 수명(초).
# GITHUB_CACHE_SECONDS=1800
